# LibSearchBot 環境設定ファイル
# このファイルをコピーして .env として保存し、APIキーを設定してください

# カーリルAPIキー（https://calil.jp/api/dashboard/ で取得）
CALIL_APPKEY=your_calil_api_key_here

# OpenAI APIキー（Phase 2以降で使用）
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic APIキー（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Amazon アフィリエイトタグ（Phase 2以降で使用）
# AMAZON_TAG=your_amazon_tag
