# LibSearchBot 環境設定ファイル
# このファイルをコピーして .env として保存し、APIキーを設定してください

# カーリルAPIキー（https://calil.jp/api/dashboard/ で取得）
CALIL_APPKEY=your_calil_api_key_here

# Anthropic APIキー（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 楽天ウェブサービス（https://webservice.rakuten.co.jp/ で取得）
RAKUTEN_APP_ID=your_rakuten_app_id_here

# アフィリエイト設定
# Amazon アフィリエイトタグ（例: yourtag-22）
AMAZON_AFFILIATE_TAG=your_amazon_tag-22

# Kindle Unlimited プロモーションURL
KINDLE_PROMO_URL=https://www.amazon.co.jp/kindle-dbs/hz/signup?tag=your_amazon_tag-22

# Audible プロモーションURL
AUDIBLE_PROMO_URL=https://www.amazon.co.jp/hz/audible/mlp?tag=your_amazon_tag-22
